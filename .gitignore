# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ── Build outputs ─────────────────────────────────────────────────────────────
dist/
build/
*.tsbuildinfo
out/

# ── Puya-TS artifacts ─────────────────────────────────────────────────────────
# Compiled TEAL / ARC32 / ARC56 stay tracked (committed in src/out/).
# Source map and internal maps are not useful in git.
*.puya.map
.watermark.json

# ── Test coverage ─────────────────────────────────────────────────────────────
coverage/

# ── Environment files ─────────────────────────────────────────────────────────
# Ignore all .env* files by default, then explicitly keep the example templates.
.env*
!.env*.example

# ── OS / editor junk ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Agent / IDE Scratchpads ───────────────────────────────────────────────────
.claude/
.pheromone/
.playwright-mcp/


