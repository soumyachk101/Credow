# TestNet -- copy to .env.local and set VITE_APP_ID (wallets switch automatically)
VITE_ALGOD_TOKEN=
VITE_ALGOD_SERVER=https://testnet-api.4160.nodely.dev
VITE_ALGOD_PORT=443
VITE_ALGOD_NETWORK=testnet
VITE_INDEXER_TOKEN=
VITE_INDEXER_SERVER=https://testnet-idx.4160.nodely.dev
VITE_INDEXER_PORT=443

# Set after deploying the contract: `npm run deploy:testnet` prints APP_ID
VITE_APP_ID=

# Circle Developer-Controlled Wallet API key for testnet USDC faucet
# Get yours at: https://console.circle.com/dashboard/developers/keys
# Requires a Circle developer-controlled wallet on Algorand testnet.
VITE_CIRCLE_API_KEY=
